# Copy to .env and adjust if needed. Do not commit .env.
# Defaults are for local development only; no real secrets here.

# Published ports on the host
FRONTEND_PORT=5173
BACKEND_PORT=8000
MOCK_PROVIDER_PORT=4010

# PostgreSQL
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Log level of the backend and the worker: DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO

# Backend: browser origin allowed to call the API (must match the frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# Note: the backend builds its database URL from the POSTGRES_* values above.

# External provider (mock) used by the backend over HTTP
PROVIDER_BASE_URL=http://mock_provider:4010/v1
PROVIDER_TOKEN=travel-demo-token
# Seconds the backend waits for the provider before giving up on a search
PROVIDER_TIMEOUT_SECONDS=5

# Bookings: how the worker follows up (seconds). Defaults shown; uncomment to change.
# An attempt saved but never answered is treated as unknown after this long
# BOOKING_STALE_INITIATED_SECONDS=60
# Unknown outcome: first lookup after this, then doubling up to the maximum, until flagged unresolved
# BOOKING_FIRST_CHECK_SECONDS=10
# BOOKING_BACKOFF_MAX_SECONDS=60
# BOOKING_UNRESOLVED_AFTER_SECONDS=600
# Pending bookings: read every FAST seconds for the first WINDOW seconds, then every SLOW seconds
# BOOKING_POLL_FAST_SECONDS=10
# BOOKING_POLL_FAST_WINDOW_SECONDS=300
# BOOKING_POLL_SLOW_SECONDS=60
# The Bookings view says "taking longer than expected" for a pending booking older than this
# BOOKING_SLOW_AFTER_SECONDS=1800
# How often the worker looks for attempts that are due
# BOOKING_WORKER_TICK_SECONDS=2

# Documents: where PDFs are stored (a shared volume in Docker; keep the default there) and recovery limits.
# DOCUMENTS_DIR=/data/documents
# An in-progress document not finished after this many seconds is put back in the queue
# DOCUMENT_STUCK_SECONDS=120
# After this many attempts an interrupted document is marked failed
# DOCUMENT_MAX_ATTEMPTS=3

# Assistant (change 9): a real model behind an OpenAI-compatible chat API. Not needed to run the rest of the app.
# Free example (OpenRouter): create a free key at https://openrouter.ai/keys, then check a model with
#   docker compose exec backend python -m app.assistant.probe --list-free
#   docker compose exec backend python -m app.assistant.probe
# The key is a secret: put it only in your own .env, never here or in a commit.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# Passed the probe on OpenRouter free (alternative: openrouter/free, which picks a model for you)
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Seconds to wait for each model call, and the most model calls for one question
# LLM_TIMEOUT_SECONDS=60
# ASSISTANT_MAX_STEPS=6
# Where the assistant reaches the MCP tools (the backend itself)
# MCP_URL=http://localhost:8000/mcp

# Provider mock clock (optional). Real time by default.
# Freeze it at an instant (ISO 8601 with offset) and/or shift real time by N seconds; frozen wins.
# MOCK_CLOCK_FROZEN_AT=2030-01-15T09:00:00Z
# MOCK_CLOCK_OFFSET_SECONDS=0

# Provider mock: seconds (mock clock) before a pending booking resolves to confirmed when read.
# MOCK_PENDING_RESOLUTION_SECONDS=30

# Frontend (URL the browser uses to reach the backend)
VITE_BACKEND_URL=http://localhost:8000
