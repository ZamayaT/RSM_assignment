# Copy to .env. Do not commit .env. Local development defaults only.
# Lines starting with "# " followed by a variable are optional: uncomment to change (defaults shown).

# Published ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
MOCK_PROVIDER_PORT=4010

# PostgreSQL
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend (FRONTEND_ORIGIN must match the frontend URL; LOG_LEVEL: DEBUG, INFO, WARNING, ERROR)
FRONTEND_ORIGIN=http://localhost:5173
# LOG_LEVEL=INFO

# Provider (mock) and the seconds to wait for it
PROVIDER_BASE_URL=http://mock_provider:4010/v1
PROVIDER_TOKEN=travel-demo-token
PROVIDER_TIMEOUT_SECONDS=5

# Bookings follow-up by the worker (seconds)
# BOOKING_STALE_INITIATED_SECONDS=60
# BOOKING_FIRST_CHECK_SECONDS=10
# BOOKING_BACKOFF_MAX_SECONDS=60
# BOOKING_UNRESOLVED_AFTER_SECONDS=600
# BOOKING_POLL_FAST_SECONDS=10
# BOOKING_POLL_FAST_WINDOW_SECONDS=300
# BOOKING_POLL_SLOW_SECONDS=60
# BOOKING_SLOW_AFTER_SECONDS=1800
# BOOKING_WORKER_TICK_SECONDS=2

# Documents: storage folder and recovery limits
# DOCUMENTS_DIR=/data/documents
# DOCUMENT_STUCK_SECONDS=120
# DOCUMENT_MAX_ATTEMPTS=3

# Assistant (optional): any OpenAI-compatible model. Free key: https://openrouter.ai/keys. Keep the key only in .env.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_TIMEOUT_SECONDS=60
# ASSISTANT_MAX_STEPS=6
# MCP_URL=http://localhost:8000/mcp

# Provider mock clock and booking resolution (optional)
# MOCK_CLOCK_FROZEN_AT=2030-01-15T09:00:00Z
# MOCK_CLOCK_OFFSET_SECONDS=0
# MOCK_PENDING_RESOLUTION_SECONDS=30

# Frontend: backend URL used by the browser; show the assistant's "Tools used" list (true or false)
VITE_BACKEND_URL=http://localhost:8000
# VITE_SHOW_ASSISTANT_TOOLS=true
