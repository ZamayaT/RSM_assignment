# Copy to .env and adjust if needed. Do not commit .env.
# Defaults are for local development only; no real secrets here.

# Published ports on the host
FRONTEND_PORT=5173
BACKEND_PORT=8000
MOCK_PROVIDER_PORT=4010

# PostgreSQL
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend: browser origin allowed to call the API (must match the frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# Note: the backend builds its database URL from the POSTGRES_* values above.

# External provider (mock) used by the backend over HTTP
PROVIDER_BASE_URL=http://mock_provider:4010/v1
PROVIDER_TOKEN=travel-demo-token

# Frontend (URL the browser uses to reach the backend)
VITE_BACKEND_URL=http://localhost:8000
